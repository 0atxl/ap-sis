# Copy this file to .env.local and fill in your TypeSafe API key (optional)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Server-only secret for "Try with demo wallet". JSON array of the funder keypair bytes.
# Generate it with the command in the README. Never prefix this with NEXT_PUBLIC_.
DEMO_FUNDER_SECRET_KEY=
# Optional. Defaults to the public Devnet RPC when empty.
DEMO_RPC_URL=https://api.devnet.solana.com
